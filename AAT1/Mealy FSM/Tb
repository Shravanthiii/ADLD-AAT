`timescale 1ns/1ps
module mealy_fsm_tb;
reg clk, reset, x;
wire z;
mealy_fsm dut (.clk(clk), .reset(reset), .x(x), .z(z));
always #5 clk = ~clk;

task send_bit;
    input bit_value;
    begin
        @(negedge clk);
        x = bit_value;
        #1;
        $display("Time=%0t Input=%b Output=%b", $time, x, z);
    end
endtask

initial begin
    clk = 0; reset = 1; x = 0;
    @(negedge clk); reset = 0;
    send_bit(1);
    send_bit(0);
    send_bit(1);
    send_bit(1);
    send_bit(0);
    send_bit(1);
    #10;
    $finish;
end
endmodule
