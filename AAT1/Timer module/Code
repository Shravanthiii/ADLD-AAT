module timer_module #(parameter PERIOD = 10) (
    input clk, reset, enable,
    output reg done,
    output reg [31:0] count
);
always @(posedge clk) begin
    if (reset) begin
        count <= 0;
        done <= 0;
    end
    else if (enable) begin
        if (count == PERIOD - 1) begin
            count <= 0;
            done <= 1;
        end
        else begin
            count <= count + 1;
            done <= 0;
        end
    end
    else begin
        done <= 0;
    end
end
endmodule
