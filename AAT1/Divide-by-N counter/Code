module divide_by_n #(parameter N = 5) (
    input clk, reset,
    output reg tick,
    output reg [31:0] count
);
always @(posedge clk) begin
    if (reset) begin
        count <= 0;
        tick <= 0;
    end
    else if (count == N-1) begin
        count <= 0;
        tick <= 1;
    end
    else begin
        count <= count + 1;
        tick <= 0;
    end
end
endmodule
