module divide_n_counter #(parameter N = 10)
(
    input clk,
    input rst,
    output reg [$clog2(N)-1:0] count,
    output reg out
);

always @(posedge clk or posedge rst)

begin

    if (rst)
    begin
        count <= 0;
        out <= 0;
    end

    else
    begin
        if (count == N-1)
        begin
            count <= 0;
            out <= ~out;
        end

        else
        begin
            count <= count + 1;
        end
    end
end

endmodule

